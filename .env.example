# Regnovum — environment template.
#
# Copy to .env (git-ignored) and fill in real values there. Never commit
# real secrets: this file documents variables and safe examples only.
#
# The production topology (compose.production.yaml, P19-T02) reads two files,
# because the roles are two and neither should hold the other's credentials:
#
#   .env.production     this file, copied and filled: the ARENA_* runtime
#                       configuration plus the values the pipeline interpolates
#                       (application image by digest, site address, ports,
#                       certificate paths). Read by the application and the
#                       worker, and passed to Compose with `--env-file`.
#   .env.production.db  only POSTGRES_PASSWORD. Read by PostgreSQL.
#
# Both are git-ignored by the `.env.*` rule and are expected to be 0600. The
# Compose file itself names where each value comes from and never what it is.
# The password inside ARENA_DATABASE_URL and POSTGRES_PASSWORD must be the same
# string: drift does not degrade silently, it fails authentication.

# Deployment environment: development | test | production
ARENA_ENV=development

# HTTP listen address (host:port). Development keeps the loopback default.
ARENA_ADDR=127.0.0.1:8080

# Optional private loopback-only administrative listener for pprof. It is
# disabled by default and must never bind a public interface.
# ARENA_ADMIN_ADDR=127.0.0.1:6060

# PostgreSQL DSN. In production this is REQUIRED and must point to the real
# database. The example below targets the local Compose service
# (compose.yaml): credentials are development-only, not reusable elsewhere.
ARENA_DATABASE_URL=postgres://arena:arena-local-dev@127.0.0.1:54329/arena?sslmode=disable

# Directory of the frontend build the server serves (P18-T07A). The server
# reads back the manifest the asset pipeline writes, so the pages reference the
# hashed files of one build. The default is the directory 'make build-web'
# writes to; a deployment that lays the build out elsewhere points this at it.
ARENA_ASSETS_DIR=web/dist

# Cursor signing secret (P18-T07B). The Arena participation journey signs the
# pagination cursors of its public lists with this key, so it must be at least
# 32 bytes and stable across restarts. Without it the journey is not mounted in
# development and the boot is refused in production. Generate one per
# environment; never reuse it between environments.
# ARENA_CURSOR_SECRET=replace-me-with-32-bytes-of-entropy

# Directory of the local email sink (P18-T07). In development and test the
# identity messages are written there, one JSON document per delivery, instead
# of being handed to a provider; a journey driven by another process — the
# browser harness of tools/e2e, or a person completing a registration by hand —
# reads the confirmation code from it. It is refused when
# ARENA_ENV=production, because a directory of account codes is not a delivery
# mechanism and no real account may have its codes written to disk.
# ARENA_EMAIL_SINK_DIR=.tmp/email-sink

# Transactional email provider (P19-T02A). In production the account journey
# queues every identity message as durable work (app.jobs, type
# 'email_delivery') and 'arena worker' renders and delivers it, so both
# processes read these two variables and both refuse to boot without them.
#
# The credential is the Resend sending key (re_...); it is a redacted secret
# that is never printed, exported or logged. The sender address is the verified
# address the provider accepts, optionally with a display name, and it is
# plain configuration: it is the address every recipient sees.
# ARENA_RESEND_API_KEY=re_replace_me
# ARENA_EMAIL_FROM=Arena <no-reply@arena.example>

# The provider endpoint is deliberately NOT configurable: with a fixed URL the
# credential can only ever be sent to the provider itself.

# Log verbosity: debug | info | warn | error
ARENA_LOG_LEVEL=info

# Database connection pool tuning (optional, safe defaults provided)
# ARENA_DB_MAX_CONNS=10
# ARENA_DB_MIN_CONNS=2
# ARENA_DB_MAX_CONN_LIFETIME=1h
# ARENA_DB_MAX_CONN_IDLE_TIME=30m
# ARENA_DB_ACQUIRE_TIMEOUT=5s

# Billing (P12-T01) — enabled commercial regions and the currency each one
# charges. Amounts are NOT configured here: they come from the versioned
# catalog shipped with the binary (internal/billing/adapters/catalog/
# products.json, from docs/MONETIZATION.md §4), so a price only changes with a
# reviewed catalog version. Empty by default: nothing is sellable until a
# region is enabled.
# ARENA_BILLING_MARKETS=BR:BRL,INTERNATIONAL:USD

# Billing — Stripe price ID of each catalog product, as MARKET/PRODUCT=PRICE_ID.
# Price IDs differ per Stripe account and mode, so they live only in the
# environment. In production (ARENA_ENV=production) every product of every
# enabled region is REQUIRED; in development and test an unset product simply
# cannot be sold yet.
# ARENA_BILLING_PRICE_IDS=BR/ink_10000=price_replace_me,BR/ink_40000=price_replace_me,BR/ink_100000=price_replace_me,BR/pass_1=price_replace_me,BR/pass_5=price_replace_me,BR/member_monthly=price_replace_me

# Billing — payment provider credential (P12-T03). Server-side Stripe key only
# (sk_... or rk_...): a publishable key (pk_...) is refused at boot. In
# production this is REQUIRED; the value is never printed, exported or logged.
# Leave it unset in development until you have a test key.
# ARENA_STRIPE_SECRET_KEY=sk_test_replace_me

# Billing — deadline of one payment provider call. Default 10s; must be
# positive and at most 1m. Idempotency keys are not configured here: they are
# chosen per operation by the billing use cases so retries stay collision-free.
# ARENA_STRIPE_TIMEOUT=10s

# Observability (P19-T05) — production telemetry, all of it OPTIONAL: a process
# without these variables serves the product and records nothing, and its
# provider adapters are simply not composed. What is never optional is the
# shape of a value that is set, so a malformed DSN or host refuses the boot
# naming the variable instead of failing as a dropped event nobody watches.
#
# The error reporter (Sentry) and the product analytics sink (PostHog) are
# reached over their HTTP APIs behind ports: no provider SDK runs in the
# process. The two credentials are secrets and never printed; the host and the
# sample rate are plain configuration. Metrics are never uploaded: the
# registry is rendered in the Prometheus text format on the administrative
# listener (ARENA_ADMIN_ADDR) at GET /metrics, next to /debug/pprof/.
# ARENA_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# ARENA_POSTHOG_API_KEY=phc_your_project_write_key
# ARENA_POSTHOG_HOST=https://us.i.posthog.com
# ARENA_ANALYTICS_SAMPLE_RATE=100

# Billing — allowlisted checkout return URLs (P12-T04). They are configuration
# and never input: no request can add to or influence the allowlist, so the
# checkout can never become an open redirect. Both must be absolute HTTP(S)
# URLs on the SAME origin (HTTPS required when ARENA_ENV=production), and they
# are required whenever the checkout use case is composed.
# ARENA_BILLING_SUCCESS_URL=https://arena.example/checkout/success
# ARENA_BILLING_CANCEL_URL=https://arena.example/checkout/cancel
