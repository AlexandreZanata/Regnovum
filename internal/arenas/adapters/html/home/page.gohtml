{{define "home"}}<!doctype html>
<html lang="{{.Locale}}"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark"><title>{{t .Locale "title"}} · Regnovum</title>
<link rel="icon" href="{{asset "realm/brand/favicon.svg"}}" type="image/svg+xml">
<link rel="stylesheet" href="{{asset "styles/realm.css"}}">
<script type="module" src="{{asset "components/realm/navigation.js"}}"></script>
</head><body class="ga-realm">
<a class="ga-skip" href="#main">{{t .Locale "skip"}}</a>
<header class="ga-realm-header">
<a href="/" class="ga-brand"><img src="{{asset "realm/brand/crest.svg"}}" alt="" width="42" height="48"><span>{{t .Locale "brand"}}</span></a>
{{template "search-field" .}}
<div class="ga-account"><img src="{{asset "realm/portraits/cidadao-128.webp"}}" alt="" width="42" height="42"><span>{{t .Locale "visitor"}}<small>{{t .Locale "visitor_note"}}</small></span><a class="ga-button" href="/login">{{t .Locale "login"}}</a></div>
</header>
<div class="ga-realm-layout">
{{template "navigation" .}}
<main id="main" tabindex="-1" class="ga-realm-main">
<div class="ga-dashboard-title"><h1>{{t .Locale "title"}}</h1><form action="/" method="get" class="ga-language"><label for="language">{{t .Locale "language"}}</label><select id="language" name="locale"><option value="pt-BR" {{if eq .Locale "pt-BR"}}selected{{end}}>Português</option><option value="en-US" {{if eq .Locale "en-US"}}selected{{end}}>English</option></select><button type="submit">→</button></form></div>
<section id="arenas" class="ga-arena-section" aria-labelledby="arenas-title">
<div class="ga-section-heading"><h2 id="arenas-title">{{if .Query}}{{t .Locale "results"}}{{else}}{{t .Locale "arenas"}}{{end}}</h2>{{if .Query}}<a href="/?locale={{.Locale}}#arenas">{{t .Locale "clear"}} ↗</a>{{end}}</div>
<nav class="ga-category-tabs" aria-label="{{t .Locale "filter"}}">{{range .Categories}}<a href="{{.Href}}" {{if .Current}}aria-current="true"{{end}}>{{t $.Locale .Key}}</a>{{end}}</nav>
{{if .Error}}<div class="ga-empty" role="alert"><p>{{t .Locale .Error}}</p><a class="ga-button" href="/?locale={{.Locale}}">{{t .Locale "retry"}}</a></div>{{else}}
<div class="ga-arena-grid">{{range .Arenas}}{{template "arena-card" (dictArena $ .)}}{{else}}<div class="ga-empty"><h3>{{t .Locale "empty"}}</h3><p>{{t .Locale "empty_hint"}}</p></div>{{end}}</div>
{{if .Next}}<a class="ga-button ga-pagination" href="{{.Next}}">{{t .Locale "more"}} →</a>{{end}}{{end}}
</section>
<div class="ga-quick-actions">
{{template "quick-arena" .}}{{template "quick-ink" .}}{{template "quick-account" .}}{{template "quick-transparency" .}}
</div>
<div class="ga-lower-panels">{{template "disputes-panel" .}}{{template "contracts-panel" .}}</div>
<footer class="ga-realm-footer"><span>{{t .Locale "footer"}}</span><a href="/transparency">{{t .Locale "nav.transparency"}} ↗</a></footer>
</main>
<aside class="ga-realm-rail" aria-label="{{t .Locale "kingdom"}}">
{{template "kingdom-panel" .}}{{template "season-panel" .}}{{template "roles-panel" .}}
</aside></div></body></html>{{end}}
