{{define "search-field"}}<form action="/" method="get" role="search" class="ga-realm-search"><label class="ga-sr-only" for="realm-search">{{t .Locale "search"}}</label><svg aria-hidden="true"><use href="{{icon "search"}}"></use></svg><input type="search" id="realm-search" name="q" value="{{.Query}}" maxlength="200" placeholder="{{t .Locale "search_placeholder"}}"><input type="hidden" name="locale" value="{{.Locale}}"><input type="hidden" name="language" value="{{.Language}}"><button type="submit" aria-label="{{t .Locale "search_button"}}">↵</button></form>{{end}}
{{define "navigation"}}<ga-realm-navigation><button class="ga-menu-toggle" type="button" aria-controls="realm-navigation" aria-expanded="false" hidden>{{t .Locale "menu"}} ☰</button><nav id="realm-navigation" class="ga-realm-navigation" aria-label="{{t .Locale "navigation"}}"><div class="ga-nav-links">{{range .Navigation}}<a href="{{.Href}}" {{if .Current}}aria-current="page"{{end}}><svg aria-hidden="true"><use href="{{icon .Icon}}"></use></svg>{{t $.Locale .Key}}</a>{{end}}</div><div class="ga-nav-bottom"><a href="/register">{{t .Locale "register"}} ↗</a><a href="#kingdom" class="ga-realm-mini"><img src="{{asset "realm/scenes/reino-hero-768.webp"}}" alt="" width="192" height="118" loading="lazy"><span>{{t .Locale "view_realm"}} →</span></a></div></nav></ga-realm-navigation>{{end}}
{{define "quick-action"}}<a class="ga-quick-card" href="{{.Href}}"><svg aria-hidden="true"><use href="{{icon .Icon}}"></use></svg><span>{{t .Locale .Title}}<small>{{t .Locale .Note}}</small></span><span aria-hidden="true">›</span></a>{{end}}
{{define "quick-arena"}}{{template "quick-action" (quick .Locale "#arenas" "swords" "activity" "activity_note")}}{{end}}
{{define "quick-ink"}}{{template "quick-action" (quick .Locale "/login" "coins" "ink" "ink_note")}}{{end}}
{{define "quick-account"}}{{template "quick-action" (quick .Locale "/login" "citizen" "account" "account_note")}}{{end}}
{{define "quick-transparency"}}{{template "quick-action" (quick .Locale "/transparency" "audit" "nav.transparency" "transparency")}}{{end}}
{{define "arena-card"}}<article class="ga-arena-card"><a class="ga-arena-visual" href="/arenas/{{.Arena.Slug}}" tabindex="-1" aria-hidden="true"><img src="{{asset .Arena.Scene}}" alt="" width="768" height="512" loading="lazy" decoding="async"><span class="ga-status ga-status--{{.Arena.Status}}">{{t .Locale .Arena.Status}}</span><span class="ga-arena-language">{{.Arena.Language}}</span></a><div class="ga-arena-content"><span class="ga-eyebrow">{{t .Locale "public"}}</span><h3><a href="/arenas/{{.Arena.Slug}}">{{.Arena.Statement}}</a></h3><span class="ga-chip">{{category .Locale .Arena.Category}}</span><div class="ga-arena-card-footer"><a class="ga-button" href="/arenas/{{.Arena.Slug}}">{{if eq .Arena.Status "published"}}{{t .Locale "open_arena"}}{{else}}{{t .Locale "read_arena"}}{{end}} <span aria-hidden="true">→</span></a><a class="ga-document-link" href="/d/{{.Arena.Slug}}">{{t .Locale "document"}} ↗</a></div></div></article>{{end}}
{{define "panel-heading"}}<div class="ga-panel-heading"><svg aria-hidden="true"><use href="{{icon .Icon}}"></use></svg><h2>{{t .Locale .Title}}</h2></div>{{end}}
{{define "disputes-panel"}}<section id="disputes" class="ga-realm-panel">{{template "panel-heading" (quick .Locale "" "scales" "disputes" "")}}<div class="ga-staged-panel"><img src="{{asset "realm/scenes/sala-arbitragem-768.webp"}}" alt="" width="100" height="76" loading="lazy"><div><span class="ga-chip">{{t .Locale "unavailable"}}</span><p>{{t .Locale "disputes_note"}}</p></div></div></section>{{end}}
{{define "contracts-panel"}}<section id="contracts" class="ga-realm-panel">{{template "panel-heading" (quick .Locale "" "scroll" "contracts" "")}}<div class="ga-staged-panel"><img src="{{asset "realm/scenes/mercado-contratos-768.webp"}}" alt="" width="100" height="76" loading="lazy"><div><span class="ga-chip">{{t .Locale "unavailable"}}</span><p>{{t .Locale "contracts_note"}}</p></div></div></section>{{end}}
{{define "kingdom-panel"}}<section id="kingdom" class="ga-realm-panel">{{template "panel-heading" (quick .Locale "" "crown" "kingdom" "")}}<div class="ga-kingdom"><img src="{{asset "realm/brand/crest.svg"}}" alt="" width="70" height="90"><div><h3>{{t .Locale "kingdom_note"}}</h3><span>{{t .Locale "charter"}}</span></div></div><a class="ga-panel-link" href="/transparency">{{t .Locale "transparency"}} <span>→</span></a></section>{{end}}
{{define "season-panel"}}<section class="ga-realm-panel">{{template "panel-heading" (quick .Locale "" "laurel" "season" "")}}<p class="ga-panel-note">{{t .Locale "season_note"}}</p></section>{{end}}
{{define "role-card"}}<details class="ga-role-card"><summary><img src="{{asset (printf "realm/portraits/%s-128.webp" .Role.ID)}}" alt="" width="64" height="76" loading="lazy"><svg aria-hidden="true"><use href="{{icon .Role.Icon}}"></use></svg><span><strong>{{t .Locale (printf "roles_data.%s.name" .Role.ID)}}</strong><small>{{t .Locale (printf "roles_data.%s.description" .Role.ID)}}</small></span><span aria-hidden="true" class="ga-disclosure-mark">+</span></summary><p>{{t .Locale "roles_boundary"}}</p></details>{{end}}
{{define "roles-panel"}}<section id="roles" class="ga-realm-panel ga-roles-panel">{{template "panel-heading" (quick .Locale "" "scroll" "roles" "")}}<div>{{range .Roles}}{{template "role-card" (dictRole $ .)}}{{end}}</div><details class="ga-more-roles"><summary>{{t .Locale "roles_more"}} <span>↓</span></summary><p>{{t .Locale "roles_note"}}</p>{{range .MoreRoles}}{{template "role-card" (dictRole $ .)}}{{end}}</details></section>{{end}}
