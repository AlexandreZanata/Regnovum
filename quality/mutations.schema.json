{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexandreZanata/Regnovum/quality/mutations.schema.json",
  "title": "Mutation testing register",
  "description": "The versioned mutation testing policy: the pinned tool and operators, the measured and deferred Q0/Q1 targets, the risk thresholds, the zero-survivor areas and the proven equivalent/hang manifest. The loader that judges it is tools/mutationaudit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "operators", "thresholds", "targets", "zero_areas", "equivalents", "exclusions"],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "The only register version the loader understands."
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version", "timeout_coefficient", "workers"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "timeout_coefficient": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 1}
      }
    },
    "operators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "deferred"],
      "properties": {
        "enabled": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "deferred": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Z_]+$": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Q0", "Q1"],
      "properties": {
        "Q0": {"type": "number", "minimum": 0, "maximum": 100},
        "Q1": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "zero_areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/zero_area" }
    },
    "equivalents": {
      "type": "array",
      "items": { "$ref": "#/$defs/equivalent" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "risk", "status"],
      "properties": {
        "package": {"type": "string", "pattern": "^internal/[a-z0-9]+/(domain|application)$"},
        "risk": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["Q0", "Q1"]}
        },
        "areas": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "status": {"enum": ["measured", "deferred"]},
        "reason": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "deferred"}}},
          "then": {"required": ["reason", "gate"]}
        }
      ]
    },
    "zero_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "paths"],
      "properties": {
        "area": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "equivalent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "file", "mutant", "class", "count", "reason", "owner"],
      "properties": {
        "package": {"type": "string", "pattern": "^internal/[a-z0-9]+/(domain|application)$"},
        "file": {"type": "string", "pattern": "^[a-z0-9_]+\\.go$"},
        "mutant": {"type": "string", "pattern": "^[A-Z_]+$"},
        "class": {"enum": ["equivalent", "hangs"]},
        "count": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "reason", "owner"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["generated", "boilerplate"]},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    }
  }
}
