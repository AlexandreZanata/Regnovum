# Fixture of the environment template: this file is the operator's contract, and
# the refusal message of the loader sends the operator here.

# Deployment environment.
ARENA_ENV=development

# Directory the sink writes to.
ARENA_SINK_DIR=.tmp/sink

# Accepted and never read by the loader: the operator defines it and the process
# drops the value, which is the orphan flag the rule refuses.
ARENA_ORPHAN=0

# Documented here and refused by the loader: following this template makes the
# process refuse to start, which is the direction the rule refuses.
ARENA_DOCUMENTED_ONLY=1
